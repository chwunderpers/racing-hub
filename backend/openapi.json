{
  "openapi": "3.1.0",
  "info": {
    "title": "Motorsport Hub",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedule": {
      "get": {
        "summary": "Schedule",
        "operationId": "schedule_api_schedule_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "MeetingResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "cancelled"
            ],
            "title": "Status",
            "default": "scheduled"
          },
          "publicationVersion": {
            "type": "string",
            "title": "Publicationversion"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "competition": {
            "type": "string",
            "title": "Competition"
          },
          "season": {
            "type": "integer",
            "title": "Season"
          },
          "circuit": {
            "type": "string",
            "title": "Circuit"
          },
          "startDate": {
            "type": "string",
            "title": "Startdate"
          },
          "endDate": {
            "type": "string",
            "title": "Enddate"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Sourceurl"
          },
          "retrievedAt": {
            "type": "string",
            "title": "Retrievedat"
          }
        },
        "type": "object",
        "required": [
          "publicationVersion",
          "id",
          "name",
          "competition",
          "season",
          "circuit",
          "startDate",
          "endDate",
          "sourceUrl",
          "retrievedAt"
        ],
        "title": "MeetingResponse"
      },
      "ScheduleResponse": {
        "properties": {
          "meetings": {
            "items": {
              "$ref": "#/components/schemas/MeetingResponse"
            },
            "type": "array",
            "title": "Meetings"
          }
        },
        "type": "object",
        "required": [
          "meetings"
        ],
        "title": "ScheduleResponse"
      }
    }
  }
}
