            "title": "Publicationversion"
          },
          "freshness": {
            "$ref": "#/components/schemas/FreshnessResponse"
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/CapabilityContribution"
            },
            "type": "array",
            "title": "Contributions"
          }
        },
        "type": "object",
