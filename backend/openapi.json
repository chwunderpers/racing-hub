          "name": {
            "type": "string",
            "title": "Name"
          },
          "length_km": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Length Km"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identity",
          "name"
        ],
        "title": "CandidateLayout"
      },
      "CandidatePlace": {
        "properties": {
          "identity": {
            "type": "string",
            "title": "Identity"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identity",
          "name"
        ],
        "title": "CandidatePlace"
      },
      "CoverageAssessment": {
        "properties": {
          "state": {
            "type": "string",
