{
  "openapi": "3.1.0",
  "info": {
    "title": "Racing Hub",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedule": {
      "get": {
        "summary": "Schedule",
        "operationId": "schedule_api_schedule_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FieldAssertion": {
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "title": "Field"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "title": "Locator"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "title": "Rule"
          },
          "preferred": {
            "type": "boolean",
            "title": "Preferred",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "value",
          "source_url",
          "retrieved_at",
          "locator",
          "rule"
        ],
        "title": "FieldAssertion"
      },
      "FreshnessResponse": {
        "properties": {
          "stale": {
            "type": "boolean",
            "title": "Stale"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "checkedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkedat"
          },
          "lastSuccessAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastsuccessat"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceFreshnessResponse"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "stale"
        ],
        "title": "FreshnessResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "MeetingResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "cancelled"
            ],
            "title": "Status",
            "default": "scheduled"
          },
          "publicationVersion": {
            "type": "string",
            "title": "Publicationversion"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "competition": {
            "type": "string",
            "title": "Competition"
          },
          "season": {
            "type": "integer",
            "title": "Season"
          },
          "circuit": {
            "type": "string",
            "title": "Circuit"
          },
          "competitionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Competitionid"
          },
          "circuitId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Circuitid"
          },
          "startDate": {
            "type": "string",
            "title": "Startdate"
          },
          "endDate": {
            "type": "string",
            "title": "Enddate"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Sourceurl"
          },
          "retrievedAt": {
            "type": "string",
            "title": "Retrievedat"
          },
          "round": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Round"
          },
          "roundId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Roundid"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "championship",
                  "test",
                  "prologue"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "fieldAssertions": {
            "items": {
              "$ref": "#/components/schemas/FieldAssertion"
            },
            "type": "array",
            "title": "Fieldassertions"
          },
          "eventTimezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventtimezone"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionResponse"
            },
            "type": "array",
            "title": "Sessions"
          }
        },
        "type": "object",
        "required": [
          "publicationVersion",
          "id",
          "name",
          "competition",
          "season",
          "circuit",
          "startDate",
          "endDate",
          "sourceUrl",
          "retrievedAt"
        ],
        "title": "MeetingResponse"
      },
      "ScheduleResponse": {
        "properties": {
          "meetings": {
            "items": {
              "$ref": "#/components/schemas/MeetingResponse"
            },
            "type": "array",
            "title": "Meetings"
          },
          "freshness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FreshnessResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "meetings"
        ],
        "title": "ScheduleResponse"
      },
      "SessionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ],
            "title": "Status"
          },
          "start": {
            "$ref": "#/components/schemas/TimeResponse"
          },
          "end": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimeResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "start",
          "end"
        ],
        "title": "SessionResponse"
      },
      "SourceFreshnessResponse": {
        "properties": {
          "sourceFamily": {
            "type": "string",
            "title": "Sourcefamily"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "checkedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkedat"
          },
          "lastSuccessAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastsuccessat"
          }
        },
        "type": "object",
        "required": [
          "sourceFamily",
          "stale"
        ],
        "title": "SourceFreshnessResponse"
      },
      "TimeResponse": {
        "properties": {
          "local": {
            "type": "string",
            "title": "Local"
          },
          "offset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offset"
          },
          "zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone"
          },
          "instant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instant"
          }
        },
        "type": "object",
        "required": [
          "local",
          "offset",
          "zone",
          "instant"
        ],
        "title": "TimeResponse"
      }
    }
  }
}
