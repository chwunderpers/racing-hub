@prefix msh: <https://w3id.org/motorsport-hub/ontology/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

msh:MeetingShape a sh:NodeShape ; sh:targetClass msh:Meeting ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:languageIn ( "en" ) ] ;
    sh:property [ sh:path msh:competition ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path msh:circuit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path msh:startDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals msh:endDate ] ;
    sh:property [ sh:path msh:endDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

msh:IdentityShape a sh:NodeShape ; sh:targetSubjectsOf msh:identity ;
    sh:property [ sh:path msh:identity ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Distinct resources cannot claim the same canonical identity key."@en ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/motorsport-hub/ontology/identity> ?identity .
                ?other <https://w3id.org/motorsport-hub/ontology/identity> ?identity .
                FILTER (?other != $this)
            }
        """ ] .